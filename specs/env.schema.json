{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rival.local/schemas/env.json",
  "title": "Rival environment catalog",
  "description": "Each target lists required variables. secret is JSON Schema writeOnly. The owning human task is the $comment value humanTask=H-xxx, or humanTask=none when the variable is derived at build time from another target. Generators read properties, description, writeOnly, and $comment. This file contains no values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["web-build", "runner", "operator", "solver-template", "ci"],
  "properties": {
    "web-build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "NEXT_PUBLIC_CHAIN_ID",
        "NEXT_PUBLIC_DEPLOYMENTS_URL",
        "NEXT_PUBLIC_SEPOLIA_RPCS",
        "NEXT_PUBLIC_RABDI_RPC",
        "NEXT_PUBLIC_ARKIV_ACCESS_KEYS_READ",
        "NEXT_PUBLIC_RUNNER_URL"
      ],
      "properties": {
        "NEXT_PUBLIC_CHAIN_ID": {
          "type": "string",
          "description": "EVM chain id. This build uses Sepolia 11155111.",
          "$comment": "humanTask=H-008"
        },
        "NEXT_PUBLIC_DEPLOYMENTS_URL": {
          "type": "string",
          "description": "URL of deployments/sepolia.json, or the literal inlined when the static export embeds it.",
          "$comment": "humanTask=H-008"
        },
        "NEXT_PUBLIC_SEPOLIA_RPCS": {
          "type": "string",
          "description": "Comma-separated CORS-capable Sepolia HTTP RPCs, at least three.",
          "$comment": "humanTask=H-008"
        },
        "NEXT_PUBLIC_RABDI_RPC": {
          "type": "string",
          "description": "Rabdi HTTP RPC. CSP connect-src reads this host. Public default is https://rpc.rabdi.db-chain.testnet.arkiv.network.",
          "$comment": "humanTask=H-008"
        },
        "NEXT_PUBLIC_ARKIV_ACCESS_KEYS_READ": {
          "type": "string",
          "description": "Comma-separated Arkiv read keys. Public and quota-limited. Not the write key.",
          "$comment": "humanTask=H-005"
        },
        "NEXT_PUBLIC_RUNNER_URL": {
          "type": "string",
          "description": "HTTPS origin of the runner. No trailing path.",
          "$comment": "humanTask=H-004"
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "SEPOLIA_RPC_URL",
        "SEPOLIA_RPC_URL_2",
        "SEPOLIA_RPC_URL_3",
        "MM_PRIVATE_KEY",
        "HOUSE_PRIVATE_KEY",
        "SOLVER_KEYS_JSON",
        "MAKERBOT_KEYS_JSON",
        "UNLISTED_BOT_PRIVATE_KEY",
        "FAUCET_MINTER_PRIVATE_KEY",
        "RELAYER_PRIVATE_KEY",
        "ARKIV_ACCESS_KEY_WRITE",
        "ARKIV_ACCESS_KEYS_READ",
        "ALLOWED_ORIGIN"
      ],
      "properties": {
        "SEPOLIA_RPC_URL": {
          "type": "string",
          "description": "Primary Sepolia HTTP RPC.",
          "writeOnly": true,
          "$comment": "humanTask=H-003"
        },
        "SEPOLIA_RPC_URL_2": {
          "type": "string",
          "description": "Second Sepolia HTTP RPC, different provider.",
          "writeOnly": true,
          "$comment": "humanTask=H-003"
        },
        "SEPOLIA_RPC_URL_3": {
          "type": "string",
          "description": "Third Sepolia HTTP RPC, different provider.",
          "writeOnly": true,
          "$comment": "humanTask=H-003"
        },
        "MM_PRIVATE_KEY": {
          "type": "string",
          "description": "Market-maker key. 0x-prefixed hex.",
          "writeOnly": true,
          "$comment": "humanTask=H-002"
        },
        "HOUSE_PRIVATE_KEY": {
          "type": "string",
          "description": "House solver key.",
          "writeOnly": true,
          "$comment": "humanTask=H-002"
        },
        "SOLVER_KEYS_JSON": {
          "type": "string",
          "description": "JSON object of solver keys: atlas, meridian, fenix, vault. Values are 0x private keys.",
          "writeOnly": true,
          "$comment": "humanTask=H-002"
        },
        "MAKERBOT_KEYS_JSON": {
          "type": "string",
          "description": "JSON array of three maker-bot private keys.",
          "writeOnly": true,
          "$comment": "humanTask=H-002"
        },
        "UNLISTED_BOT_PRIVATE_KEY": {
          "type": "string",
          "description": "Key that is never registered. Used for the gated-fill revert demo.",
          "writeOnly": true,
          "$comment": "humanTask=H-002"
        },
        "FAUCET_MINTER_PRIVATE_KEY": {
          "type": "string",
          "description": "TestToken minter.",
          "writeOnly": true,
          "$comment": "humanTask=H-002"
        },
        "RELAYER_PRIVATE_KEY": {
          "type": "string",
          "description": "Gas payer for relayed cancelBySig.",
          "writeOnly": true,
          "$comment": "humanTask=H-002"
        },
        "ARKIV_ACCESS_KEY_WRITE": {
          "type": "string",
          "description": "Arkiv write key for the publisher wallet.",
          "writeOnly": true,
          "$comment": "humanTask=H-005"
        },
        "ARKIV_ACCESS_KEYS_READ": {
          "type": "string",
          "description": "Comma-separated Arkiv read keys.",
          "writeOnly": true,
          "$comment": "humanTask=H-005"
        },
        "ALLOWED_ORIGIN": {
          "type": "string",
          "description": "Frontend origin allowed by CORS. Equals the production web URL.",
          "$comment": "humanTask=H-008"
        }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "OPERATOR_PRIVATE_KEY",
        "SEPOLIA_RPC_URL",
        "SEPOLIA_RPC_URL_2",
        "SEPOLIA_RPC_URL_3",
        "ETHERSCAN_API_KEY",
        "ENS_PARENT_LABEL"
      ],
      "properties": {
        "OPERATOR_PRIVATE_KEY": {
          "type": "string",
          "description": "Deploy, pools, and ENS bootstrap. Founder machine only. Never copied to the runner.",
          "writeOnly": true,
          "$comment": "humanTask=H-002"
        },
        "SEPOLIA_RPC_URL": {
          "type": "string",
          "description": "Primary Sepolia HTTP RPC.",
          "writeOnly": true,
          "$comment": "humanTask=H-003"
        },
        "SEPOLIA_RPC_URL_2": {
          "type": "string",
          "description": "Second Sepolia HTTP RPC.",
          "writeOnly": true,
          "$comment": "humanTask=H-003"
        },
        "SEPOLIA_RPC_URL_3": {
          "type": "string",
          "description": "Third Sepolia HTTP RPC.",
          "writeOnly": true,
          "$comment": "humanTask=H-003"
        },
        "ETHERSCAN_API_KEY": {
          "type": "string",
          "description": "Etherscan API key used to verify Sepolia contracts.",
          "writeOnly": true,
          "$comment": "humanTask=H-007"
        },
        "ENS_PARENT_LABEL": {
          "type": "string",
          "description": "Parent ENS label. Target rival. Fallback chosen in H-006.",
          "$comment": "humanTask=H-006"
        }
      }
    },
    "solver-template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["SEPOLIA_RPC_URL", "SOLVER_PRIVATE_KEY", "ARKIV_ACCESS_KEY_WRITE"],
      "properties": {
        "SEPOLIA_RPC_URL": {
          "type": "string",
          "description": "Sepolia HTTP RPC for the third-party solver.",
          "writeOnly": true,
          "$comment": "humanTask=none"
        },
        "SOLVER_PRIVATE_KEY": {
          "type": "string",
          "description": "Key named by solver:init --key-env. The judge generates this locally.",
          "writeOnly": true,
          "$comment": "humanTask=none"
        },
        "ARKIV_ACCESS_KEY_WRITE": {
          "type": "string",
          "description": "Write key for the solver wallet that publishes presence.",
          "writeOnly": true,
          "$comment": "humanTask=H-005"
        }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["GITHUB_REPO_URL", "SEPOLIA_RPC_URL", "ETHERSCAN_API_KEY"],
      "properties": {
        "GITHUB_REPO_URL": {
          "type": "string",
          "description": "Public git remote.",
          "$comment": "humanTask=H-001"
        },
        "SEPOLIA_RPC_URL": {
          "type": "string",
          "description": "Sepolia HTTP RPC for fork tests.",
          "writeOnly": true,
          "$comment": "humanTask=H-003"
        },
        "ETHERSCAN_API_KEY": {
          "type": "string",
          "description": "Etherscan API key for verification in CI.",
          "writeOnly": true,
          "$comment": "humanTask=H-007"
        }
      }
    }
  }
}
