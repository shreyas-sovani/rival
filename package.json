{
  "name": "rival",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "axe-primitives": "./apps/web/src/components/ui/axe-primitives.mjs"
  },
  "scripts": {
    "postinstall": "mkdir -p node_modules/.bin && ln -sfn ../../apps/web/src/components/ui/axe-primitives.mjs node_modules/.bin/axe-primitives && chmod +x apps/web/src/components/ui/axe-primitives.mjs",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "forge:build": "forge build --root contracts",
    "forge:test": "forge test --root contracts",
    "gen:abis": "node --experimental-strip-types scripts/gen-abis.ts",
    "backlog:board": "node --experimental-strip-types scripts/backlog.ts board",
    "backlog:verify": "node --experimental-strip-types scripts/backlog.ts verify",
    "territory:check": "node --experimental-strip-types scripts/territory-check.ts",
    "freeze:check": "node --experimental-strip-types scripts/freeze-check.ts",
    "freeze:write": "node --experimental-strip-types scripts/freeze-write.ts",
    "env:check": "node --experimental-strip-types scripts/env-check.ts",
    "verify:deployments": "node --experimental-strip-types scripts/verify-deployments.ts",
    "audit:egress": "node --experimental-strip-types scripts/audit-egress.ts",
    "preflight": "node --experimental-strip-types scripts/preflight.ts",
    "licenses:table": "node --experimental-strip-types scripts/licenses-table.ts",
    "web:dev": "pnpm --filter @rival/web dev",
    "web:build": "pnpm --filter @rival/web build",
    "web:preview": "pnpm --filter @rival/web exec next start",
    "runner:dev": "node --import tsx apps/runner/src/server.ts",
    "solver:init": "node --experimental-strip-types scripts/cli/solver-init.ts",
    "solver:dev": "node --experimental-strip-types scripts/cli/solver-dev.ts",
    "cli:intent": "node --experimental-strip-types scripts/cli/intent.ts",
    "cli:book": "node --experimental-strip-types scripts/cli/book.ts",
    "cli:verify": "node --experimental-strip-types scripts/cli/verify.ts",
    "e2e": "node -e \"console.error('NOT_IMPLEMENTED(S-011)');process.exit(3)\"",
    "e2e:synthetic": "node -e \"console.error('NOT_IMPLEMENTED(M-027)');process.exit(3)\""
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "ajv-cli": "5",
    "eslint": "^9.16.0",
    "globals": "^15.13.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.15",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.18.0"
  }
}
