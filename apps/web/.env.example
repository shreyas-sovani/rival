# Generated from specs/env.schema.json. No values.

# target: web-build

# EVM chain id. This build uses Sepolia 11155111.
# secret=false humanTask=H-008
NEXT_PUBLIC_CHAIN_ID=

# URL of deployments/sepolia.json, or the literal inlined when the static export embeds it.
# secret=false humanTask=H-008
NEXT_PUBLIC_DEPLOYMENTS_URL=

# Comma-separated CORS-capable Sepolia HTTP RPCs, at least three.
# secret=false humanTask=H-008
NEXT_PUBLIC_SEPOLIA_RPCS=

# Rabdi HTTP RPC. CSP connect-src reads this host. Public default is https://rpc.rabdi.db-chain.testnet.arkiv.network.
# secret=false humanTask=H-008
NEXT_PUBLIC_RABDI_RPC=

# Comma-separated Arkiv read keys. Public and quota-limited. Not the write key.
# secret=false humanTask=H-005
NEXT_PUBLIC_ARKIV_ACCESS_KEYS_READ=

# HTTPS origin of the runner. No trailing path.
# secret=false humanTask=H-004
NEXT_PUBLIC_RUNNER_URL=
